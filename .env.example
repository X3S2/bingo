# =============================================================
# StreamBingo – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:4000

# --- JWT ---
# Must be at least 32 random characters
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# --- Twitch OAuth ---
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
# Must match what you set in dev.twitch.tv/console
TWITCH_REDIRECT_URI=http://localhost:4000/api/auth/callback/twitch

# --- Twitch EventSub ---
# Random secret string (min 10, max 100 chars) for HMAC validation
TWITCH_EVENTSUB_SECRET=CHANGE_ME_TO_A_RANDOM_EVENTSUB_SECRET
# The public URL where Twitch can reach your backend for webhook events
TWITCH_EVENTSUB_CALLBACK_URL=https://yourdomain.ipv64.net/api/eventsub

# --- Database (PostgreSQL 17) ---
DATABASE_URL=postgresql://streambingo:streambingo_password@streambingo-db:5432/streambingo?schema=public
POSTGRES_DB=streambingo
POSTGRES_USER=streambingo
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# --- Redis ---
REDIS_URL=redis://streambingo-cache:6379
# Enable Redis Socket.IO adapter for horizontal scaling (optional)
REDIS_ADAPTER_ENABLED=false

# --- Frontend (Next.js) ---
NEXTAUTH_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Admin Setup ---
# One-time token for the first-run Setup Wizard
# Will be invalidated after setup is complete
ADMIN_SETUP_TOKEN=CHANGE_ME_TO_A_RANDOM_SETUP_TOKEN

# --- Backup (optional, for pg_dump cron) ---
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
